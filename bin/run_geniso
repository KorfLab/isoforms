#!/usr/bin/env python3

import argparse
import glob
import os
import subprocess
import multiprocessing as mp
from multiprocessing import Pool
import time

parser = argparse.ArgumentParser(description='wrapper for geniso')
parser.add_argument('apc_dir', type=str, metavar='<directory>', 
	help='directory with APC .gff3 and .fa files')
parser.add_argument('model', type=str, metavar='<file>',
	help='splice model file')
parser.add_argument('--weights', required=False, type=str, metavar='<file>',
	help='file with model weights, optional')
parser.add_argument('--bli', action='store_true',
	help='create only biologically likely isoforms by only using '
	'observed splice sites from gff')
parser.add_argument('--outdir', required=False, type=str, default='APCisos/',
	metavar='<outdir>', help='name of output directory [%(default)s]')
parser.add_argument('--outname', required=False, type=str, 
	help='name for output gffs i.e. APC_optiso_nmd')
parser.add_argument('--limit', required=False, type=int, default=100,
	metavar='<int>', help='limit number of transcripts [%(default)i]')
parser.add_argument('--nmd', action='store_true', 
	help='use gff file to find nmd targets')
parser.add_argument('--program', required=False, type=str, default='geniso', 
	metavar='<executable>', help='path to geniso')
parser.add_argument('--cpu', required=False, type=int, default=1,
	metavar='<int>', help='number of cpus to use [%(default).i]')

args = parser.parse_args()

if not args.apc_dir.endswith('/'):
	args.apc_dir = f'{args.apc_dir}/'

fpaths = {}
for fa_path in glob.glob(f'{args.apc_dir}/*.fa'):
	gID = '.'.join(fa_path.split('.')[-3:-1]) 
	gff_path = '.'.join(fa_path.split('.')[:-1]) + '.gff3'
	fpaths[gID] = [(fa_path), (gff_path)]

# why does using no weights make the program run slower?
if args.weights:
	weights = {}
	with open(args.weights, 'r') as file:
		for line in file.readlines():
			line = line.rstrip()
			if line.startswith('gid'): continue
			line = line.split(',')
			weights[line[0]] = [x for x in line[1:]]
	
# nmd and bli are both the gff
def generate(prog, fasta, model, wacc, wdon, wexs, wins, wexl, winl, 
			winf, limit, nmd=False, bli=False):
				
	# --nmd means gff is passed to --translate in geniso
	if nmd and not bli:
		cmd = (
			f'./{prog} {fasta} {model} --wacc {wacc} --wdon {wdon} '
			f'--wexs {wexs} --wins {wins} --wexl {wexl} --winl {winl} '
			f'--winf {winf} --limit {limit} --translate {nmd}'
		)
		
	# gff also needs to be passed to --gff in geniso, which gets splice sites from gff
	elif bli and not nmd:
		cmd = (
			f'./{prog} {fasta} {model} --wacc {wacc} --wdon {wdon} '
			f'--wexs {wexs} --wins {wins} --wexl {wexl} --winl {winl} '
			f'--winf {winf} --limit {limit} --gff {bli}'
		)
		
	elif bli and nmd:
		cmd = (
			f'./{prog} {fasta} {model} --wacc {wacc} --wdon {wdon} '
			f'--wexs {wexs} --wins {wins} --wexl {wexl} --winl {winl} '
			f'--winf {winf} --limit {limit} --gff {bli} --translate {nmd}'
		)
		
	else:
		cmd = (
			f'./{prog} {fasta} {model} --wacc {wacc} --wdon {wdon} '
			f'--wexs {wexs} --wins {wins} --wexl {wexl} --winl {winl} '
			f'--winf {winf} --limit {limit}'
		)
		
	cmd = cmd.split(' ')
	gid = '.'.join(cmd[1].split('.')[-3:-1])
	print(f'working on {gid}', flush=True)
	output = subprocess.run(cmd, stdout=subprocess.PIPE, text=True).stdout
	print(f'{gid} is done', flush=True)
	return output.rstrip()

def worker(in_put):

	return generate(
		in_put[0], in_put[1], in_put[2], in_put[3], in_put[4], 
		in_put[5], in_put[6], in_put[7], in_put[8], in_put[9], 
		in_put[10], in_put[11], in_put[12]
		)
     
inputs = []
for gID in fpaths:
	if args.weights:
		wacc = weights[gID][1]
		wdon = weights[gID][2]
		wexs = weights[gID][3]
		wins = weights[gID][4]
		wexl = weights[gID][5]
		winl = weights[gID][6]
		winf = weights[gID][7]
	else:
		wacc = 1.0
		wdon = 1.0
		wexs = 1.0
		wins = 1.0
		wexl = 1.0
		winl = 1.0
		winf = 1.0
	if args.nmd and not args.bli:
		input = [
			args.program, fpaths[gID][0], args.model, wacc, wdon, wexs, 
			wins, wexl, winl, winf, args.limit, fpaths[gID][1], False
		]
	elif args.bli and not args.nmd:
		input = [
			args.program, fpaths[gID][0], args.model, wacc, wdon, wexs, 
			wins, wexl, winl, winf, args.limit, False, fpaths[gID][1]
		]
	elif args.bli and args.nmd:
		input = [
			args.program, fpaths[gID][0], args.model, wacc, wdon, wexs, 
			wins, wexl, winl, winf, args.limit, fpaths[gID][1], fpaths[gID][1]
		]
	else:
		input = [
			args.program, fpaths[gID][0], args.model, wacc, wdon, wexs, 
			wins, wexl, winl, winf, args.limit, False, False
		]
	inputs.append(input)

start = time.perf_counter()
with Pool(processes=args.cpu) as pool:
    result = pool.map(worker, inputs)

if not os.path.exists(args.outdir):
    os.makedirs(args.outdir)

for res in result:
	
	gID = ''
	for line in res.split('\n'):
		if line.startswith('# name:'):
			gID = line.split(' ')[2]
			break

	if args.outname:
		f = open(f'{args.outdir}{gID}.{args.outname}.gff', 'w')
	else:
		f = open(f'{args.outdir}{gID}.APC.gff', 'w')
	for line in res.split('\n'):
		f.write(line+'\n')         
	f.close()

end = time.perf_counter()
print('time:', end-start)

